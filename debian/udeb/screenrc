# /etc/screenrc
# Stripped down version for udeb (debian-installer)
# 2016  Roger Shimizu <rogershimizu@gmail.com>

# SETTINGS

startup_message off

#defflow on # will force screen to process ^S/^Q
#autodetach off

vbell on
vbell_msg "   Wuff  ----  Wuff!!  "

defscrollback 1024
bufferfile $HOME/.screen-exchange

# KEYBINDINGS

# Remove some stupid / dangerous key bindings
bind ^k
#bind L
bind ^\
# Make them better
bind \\ quit
bind K kill
bind } history

# TERMINAL SETTINGS

term screen5

hardstatus alwaysfirstline "%{i2;0}[%= %{7;0}%?%-Lw%?%{1} (%{i7}%n*%f%t%?(%u)%?%{1})%{7}%?%+Lw%?%?%= %{2}][%{i4} %M %d %{i7}%c %{2}]"

# Enable non-blocking mode to better cope with flaky ssh connections.
defnonblock 5

# STARTUP SCREENS

# window 0: maps to window 1
# window 1: debian installer
# window 2: shell
# window 3: shell
# window 4: syslog

shell /bin/sh
defutf8 on

bind c screen 1
bind ^c screen 1
bind 0 select 1

screen -t start	0 sleep 1
screen -t shell	2 /bin/sh
screen -t shell	3 /bin/sh
screen -t log	4 tail -f /var/log/syslog
shelltitle shell
